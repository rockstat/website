{
  "name": "rockstat-website",
  "private": true,
  "bin": {
    "rockstat": "./rockstat"
  },
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "start:dev": "pnpm dev",
    "build:prepare": "rimraf out .next && node ./rockstat build-sitemap",
    "build": "pnpm build:prepare && next build",
    "build:export": "cross-env EXPORT=1 pnpm build",
    "export": "pnpm build:export",
    "start": "next start",
    "start:serve": "serve out",
    "serve": "serve out",
    "analyze": "cross-env ANALYZE=1 next build",
    "lint:css": "stylelint \"styles/**/*.css\" \"components/**/*.css\"",
    "clean": "rimraf out .next",
    "lint": "eslint . && stylelint \"styles/**/*.css\" \"components/**/*.css\""
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "classnames": "^2.5.1",
    "mermaid": "^12.2.0",
    "next": "^16.4.2",
    "nprogress": "^0.2.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-youtube": "^10.1.0",
    "styled-jsx": "5.1.6"
  },
  "devDependencies": {
    "@mapbox/rehype-prism": "^0.9.0",
    "@mdx-js/loader": "^3.1.1",
    "@next/bundle-analyzer": "^16.4.2",
    "@next/mdx": "^16.4.2",
    "@pierreburel/postcss-rem": "^4.0.0",
    "@svgr/cli": "^8.1.0",
    "commander": "^15.0.0",
    "cross-env": "^10.1.0",
    "d3-dsv": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.2",
    "js-yaml": "^5.5.0",
    "postcss": "^8.5.30",
    "postcss-advanced-variables": "^5.0.0",
    "postcss-atroot": "^0.2.4",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-mixins": "^12.1.2",
    "postcss-nested": "^9.0.0",
    "postcss-preset-env": "^11.6.1",
    "postcss-property-lookup": "^3.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-emoji": "^5.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-images": "^4.1.0",
    "remark-mdx-frontmatter": "^6.0.0",
    "rimraf": "^6.1.3",
    "serve": "^14.2.6",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
